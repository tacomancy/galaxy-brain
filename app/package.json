{
  "name": "galaxy-brain",
  "productName": "Galaxy Brain",
  "version": "0.13.1",
  "description": "The Galaxy Brain desktop Knowledge Workbench.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24.19.0"
  },
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "format": "prettier --write src tests tools ./*.ts ./*.mjs ./*.json",
    "format:check": "prettier --check src tests tools ./*.ts ./*.mjs ./*.json",
    "lint": "eslint .",
    "lint:complexity": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:docs": "node ../scripts/test-documentation.mjs",
    "test:mcdc": "vitest run tests/tools/mcdc.test.ts",
    "check:mcdc": "tsx tools/check-mcdc.ts",
    "test:provider-free": "npm run package && wdio run ./wdio.conf.ts --spec ./tests/workflows/v1-provider-free*.e2e.ts",
    "test:coverage": "vitest run --coverage && vitest run --coverage --config vitest.per-file.config.ts",
    "check:changed-coverage": "tsx tools/check-changed-lines-coverage.ts",
    "test:workflow": "npm run package && wdio run ./wdio.conf.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:mcdc && npm run check:mcdc && npm run test:docs && npm run docs:check",
    "prepackage": "node -e \"if (process.version !== 'v24.19.0') { throw new Error('Galaxy Brain requires Node 24.19.0. Run nvm use before packaging.') }\"",
    "docs:check": "node ../scripts/check-documentation.mjs",
    "package": "electron-forge package"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "@wdio/cli": "9.31.4",
    "@wdio/electron-service": "10.2.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.4",
    "@wdio/mocha-framework": "9.31.2",
    "electron": "44.0.0",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "prettier": "3.9.6",
    "puppeteer-core": "24.43.1",
    "ts-loader": "9.6.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "webpack": "5.110.1"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.1",
    "deepmerge-ts": "8.0.2",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "serialize-javascript": "7.1.0",
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
